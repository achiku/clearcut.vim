# Basic functionality tests for clearcut.vim

Before:
  " Set up test environment
  let g:clearcut_model = 'gpt-4o-mini'
  let g:clearcut_target_ratio = 0.75

After:
  " Clean up
  silent! %bwipeout!

# ==============================================================================
# Configuration Tests
# ==============================================================================

Execute (default model is gpt-4o-mini):
  unlet! g:clearcut_model
  Assert !exists('g:clearcut_model'), 'g:clearcut_model should not exist'

Execute (default ratio is 0.75):
  unlet! g:clearcut_target_ratio
  Assert !exists('g:clearcut_target_ratio'), 'g:clearcut_target_ratio should not exist'

Execute (can override model):
  let g:clearcut_model = 'gpt-4'
  AssertEqual 'gpt-4', g:clearcut_model

Execute (can override endpoint):
  let g:clearcut_endpoint = 'https://custom.api.com/v1/chat'
  AssertEqual 'https://custom.api.com/v1/chat', g:clearcut_endpoint

# ==============================================================================
# Error Handling Tests
# ==============================================================================

Execute (empty text should error):
  enew
  call setline(1, ['', '  ', ''])

  " Capture error message
  redir => output
  silent! call clearcut#Rewrite(1, 3)
  redir END

  Assert output =~ 'No text selected', 'Should show "No text selected" error'

Execute (missing OPEN_AI_KEY should error):
  enew
  call setline(1, 'Test text')

  " Save and unset environment variable
  let saved_key = $OPEN_AI_KEY
  let $OPEN_AI_KEY = ''

  redir => output
  silent! call clearcut#Rewrite(1, 1)
  redir END

  " Restore
  let $OPEN_AI_KEY = saved_key

  Assert output =~ 'OPEN_AI_KEY', 'Should show OPEN_AI_KEY error'

# ==============================================================================
# Command Tests
# ==============================================================================

Execute (Clearcut command exists):
  Assert exists(':Clearcut'), 'Clearcut command should exist'

Execute (Clearcut command accepts range):
  enew
  call setline(1, ['Line 1', 'Line 2', 'Line 3'])

  " This should not error on the command itself
  " (it will error on missing API key, but command should be recognized)
  try
    2,3Clearcut
  catch /^Vim\%((\a\+)\)\=:E/
    " Ignore Vim errors, we're just testing command exists
  catch
    " Expected - API key missing
  endtry

# ==============================================================================
# Mapping Tests
# ==============================================================================

Execute (visual mode mapping exists):
  " Check that the mapping is defined
  let mappings = execute('xmap <leader>cct')
  Assert mappings =~ 'Clearcut', 'Visual mode mapping should exist'

# ==============================================================================
# Mock API Tests
# ==============================================================================

Execute (successful API call with mocked curl):
  if !executable('curl')
    Log 'Skipping: curl not available'
  else
    enew
    call setline(1, 'This is a test sentence that should be shortened.')

    " Create a mock curl script
    let mock_curl = tempname()
    call writefile([
      \ '#!/bin/bash',
      \ 'echo ''{"choices":[{"message":{"content":"Test shortened."}}]}'''
      \ ], mock_curl)
    call system('chmod +x ' . shellescape(mock_curl))

    " Temporarily modify PATH
    let old_path = $PATH
    let $PATH = fnamemodify(mock_curl, ':h') . ':' . $PATH
    let $OPEN_AI_KEY = 'test-key'

    " Mock curl by creating a wrapper
    let curl_wrapper = fnamemodify(mock_curl, ':h') . '/curl'
    call writefile([
      \ '#!/bin/bash',
      \ 'if [[ "$*" == *"openai.com"* ]] || [[ "$*" == *"api.com"* ]]; then',
      \ '  echo ''{"choices":[{"message":{"content":"Test shortened."}}]}''',
      \ '  exit 0',
      \ 'fi',
      \ 'exec /usr/bin/curl "$@"'
      \ ], curl_wrapper)
    call system('chmod +x ' . shellescape(curl_wrapper))

    " Run the command
    try
      call clearcut#Rewrite(1, 1)

      " Check that text was appended
      AssertEqual 2, line('$'), 'Should have 2 lines after rewrite'
      AssertEqual 'Test shortened.', getline(2), 'Should append shortened text'
    finally
      " Cleanup
      let $PATH = old_path
      call delete(mock_curl)
      call delete(curl_wrapper)
    endtry
  endif

# ==============================================================================
# Integration Tests (requires real API key)
# ==============================================================================

Execute (real API call - only if OPEN_AI_KEY is set):
  if empty($OPEN_AI_KEY) || $OPEN_AI_KEY =~ '^test'
    Log 'Skipping real API test: OPEN_AI_KEY not set or is mock'
  else
    enew
    call setline(1, 'This is a very long sentence that contains many unnecessary words and could definitely be made much more concise and shorter.')

    let original_lines = line('$')
    call clearcut#Rewrite(1, 1)

    " Should have added at least one line
    Assert line('$') > original_lines, 'Should append result below original text'

    " The appended text should be shorter
    let original_len = len(getline(1))
    let result_len = len(getline(2))
    Assert result_len < original_len, 'Result should be shorter than original'
  endif
